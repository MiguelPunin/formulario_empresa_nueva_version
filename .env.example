DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reportes
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_HOURS=12
# Only the public API origin is exposed to the frontend build. Empty = same origin.
PUBLIC_API_BASE_URL=
# For integration tests: dedicated disposable database, NEVER production.
TEST_DATABASE_URL=

# Backend only: persistent random secret (64 hex characters). Never expose in PUBLIC_ variables.
SIGNER_CODE_PEPPER=
